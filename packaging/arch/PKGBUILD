# Maintainer: Piotr Stasiak <peter.mutd@googlemail.com>
pkgname=minesweeper
pkgver=1.0           # will be overridden by pkgver() function if needed
pkgrel=1
pkgdesc="Simple Minesweeper clone implemented in C using GTK4"
arch=('x86_64')
url="https://github.com/pstasiak2000/MineSweeper"
license=('MIT')
depends=('gtk4' 'librsvg')
makedepends=('cmake' 'pkgconf' 'glib2')
source=()
#source=("https://github.com/pstasiak2000/MineSweeper/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # replace with actual sha256sum for release tarball

# Optional: auto-update pkgver from git tag
# pkgver() {
#     cd "$srcdir/MineSweeper"
#     git describe --tags | sed 's/^v//'
# }

build() {
    mkdir -p build
    cd build
    cmake -DCMAKE_INSTALL_PREFIX=/usr ..
    make
}

package() {
    cd build
    make DESTDIR="$pkgdir" install
}

