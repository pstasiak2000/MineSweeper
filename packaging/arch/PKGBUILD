pkgname=minesweeper
pkgver=1.0
pkgrel=1
pkgdesc="Simple Minesweeper clone implemented in C using GTK4"
arch=('x86_64')
license=('MIT')
depends=('gtk4' 'librsvg')
makedepends=('cmake' 'pkgconf' 'glib2')

source=(
  "$pkgname-$pkgver::file://$srcdir/../" 
)
noextract=()

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" \
          -B "$srcdir/$pkgname-$pkgver/build" \
          -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/$pkgname-$pkgver/build"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname-$pkgver/build"

    install -Dm644 "$srcdir/$pkgname-$pkgver/data/org.example.MineSweeper.desktop" \
        "$pkgdir/usr/share/applications/org.example.MineSweeper.desktop"
    install -Dm644 "$srcdir/$pkgname-$pkgver/data/org.example.MineSweeper.appdata.xml" \
        "$pkgdir/usr/share/metainfo/org.example.MineSweeper.appdata.xml"
    install -Dm644 "$srcdir/$pkgname-$pkgver/resources/icons/org.example.MineSweeper.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.example.MineSweeper.svg"
    install -Dm644 "$srcdir/$pkgname-$pkgver/resources/icons/org.example.MineSweeper.png" \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/org.example.MineSweeper.png"
}
