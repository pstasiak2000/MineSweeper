# Maintainer: Piotr Stasiak <peter.mutd@googlemail.com>
pkgname=minesweeper
pkgver=1.0
pkgrel=1
pkgdesc="Simple Minesweeper clone implemented in C using GTK4"
arch=('x86_64')
url="https://github.com/pstasiak2000/MineSweeper"
license=('MIT')
depends=('gtk4' 'librsvg')
makedepends=('cmake' 'pkgconf' 'glib2' 'gtk4')
source=()   # local build, no tarballs
sha256sums=()

build() {
    mkdir -p build
    cd build

    # Generate the GResources source file
    glib-compile-resources ../resources/resources.gresource.xml --generate-source --target=resources.c

    # Run CMake from the repo root
    cmake -DCMAKE_INSTALL_PREFIX=/usr ..
    make
}

package() {
    cd build
    make DESTDIR="$pkgdir" install

    # Install desktop file
    install -Dm644 ../data/org.example.MineSweeper.desktop \
        "$pkgdir/usr/share/applications/org.example.MineSweeper.desktop"

    # Install AppStream metadata
    install -Dm644 ../data/org.example.MineSweeper.appdata.xml \
        "$pkgdir/usr/share/metainfo/org.example.MineSweeper.appdata.xml"

    # Install icons
    install -Dm644 ../resources/icons/org.example.MineSweeper.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.example.MineSweeper.svg"

    install -Dm644 ../resources/icons/org.example.MineSweeper.png \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/org.example.MineSweeper.png"
}
