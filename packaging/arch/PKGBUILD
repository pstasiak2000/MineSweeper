# Maintainer: Piotr Stasiak <peter.mutd@googlemail.com>
pkgname=minesweeper
pkgver=1.0
pkgrel=1
pkgdesc="Simple Minesweeper clone implemented in C using GTK4"
arch=('x86_64')
url="https://github.com/pstasiak2000/MineSweeper"
license=('MIT')
depends=('gtk4' 'librsvg')
makedepends=('cmake' 'pkgconf' 'glib2')
source=()   # building from local source

build() {
    # Build inside a separate directory
    mkdir -p build
    cd build

    # Use the directory containing CMakeLists.txt as source
    cmake -DCMAKE_INSTALL_PREFIX=/usr "$srcdir"
    make
}

package() {
    cd build
    make DESTDIR="$pkgdir" install
}


